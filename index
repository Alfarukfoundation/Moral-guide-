<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MGAID - Moral Guide Awareness Initiative, Dutsinma</title>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
  <style>
    /* Global Styles */
    body {
      font-family: 'Roboto', sans-serif;
      margin: 0;
      padding: 0;
      line-height: 1.6;
      background-color: #f9f9f9;
      color: #333;
    }
    a { text-decoration: none; color: inherit; }

    /* Header */
    header {
      background-color: #004080;
      color: white;
      padding: 20px 0;
      text-align: center;
    }
    header img {
      max-width: 120px;
    }
    header h1 {
      margin: 10px 0 5px;
      font-size: 28px;
    }
    header p {
      margin: 0;
      font-style: italic;
    }

    /* Navigation */
    nav {
      background-color: #0066cc;
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
    }
    nav a {
      color: white;
      padding: 15px 20px;
      transition: background 0.3s;
    }
    nav a:hover {
      background-color: #0055a5;
    }

    /* Sections */
    section {
      padding: 50px 20px;
      max-width: 1000px;
      margin: auto;
    }
    section h2 {
      text-align: center;
      margin-bottom: 20px;
      color: #004080;
    }
    .about, .programs {
      background-color: white;
      border-radius: 8px;
      padding: 20px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
      margin-bottom: 30px;
    }

    /* Programs Grid */
    .programs-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
    }
    .program-card {
      background-color: #e6f0ff;
      border-radius: 8px;
      padding: 15px;
      text-align: center;
    }

    /* Contact Form */
    form {
      display: flex;
      flex-direction: column;
      max-width: 500px;
      margin: auto;
    }
    form input, form textarea {
      margin-bottom: 15px;
      padding: 10px;
      border-radius: 5px;
      border: 1px solid #ccc;
      font-size: 16px;
    }
    form button {
      padding: 12px;
      background-color: #004080;
      color: white;
      font-size: 16px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }
    form button:hover {
      background-color: #00264d;
    }

    /* Footer */
    footer {
      text-align: center;
      padding: 20px;
      background-color: #004080;
      color: white;
    }
    footer a { color: #ffcc00; }
  </style>
</head>
<body>

  <!-- Header -->
  <header>
    <img src="logo.png" alt="MGAID Logo">
    <h1>Moral Guide Awareness Initiative, Dutsinma (MGAID)</h1>
    <p>Shaping Minds, Strengthening Morals</p>
  </header>

  <!-- Navigation -->
  <nav>
    <a href="#about">About</a>
    <a href="#programs">Programs</a>
    <a href="#contact">Contact</a>
  </nav>

  <!-- About Section -->
  <section id="about" class="about">
    <h2>About Us</h2>
    <p><strong>Vision:</strong> To build a morally responsible and value-driven society.</p>
    <p><strong>Mission:</strong> To educate, inspire, and empower individuals—especially youths—with moral values and life skills.</p>
    <p><strong>Objectives:</strong> Promote moral awareness, provide mentorship, discourage social vices, encourage leadership and responsible citizenship.</p>
  </section>

  <!-- Programs Section -->
  <section id="programs" class="programs">
    <h2>Our Programs</h2>
    <div class="programs-grid">
      <div class="program-card">
        <h3>Interpersonal Skills Training</h3>
        <p>Lectures and workshops for senior secondary students on communication, leadership, and relationship skills.</p>
      </div>
      <div class="program-card">
        <h3>Community Awareness Campaigns</h3>
        <p>Programs to educate the community on moral values and ethical living.</p>
      </div>
      <div class="program-card">
        <h3>Youth Mentorship</h3>
        <p>Providing guidance and support to help youths make positive life choices.</p>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact">
    <h2>Contact Us</h2>
    <form>
      <input type="text" placeholder="Your Name" required>
      <input type="email" placeholder="Your Email" required>
      <textarea placeholder="Your Message" rows="5" required></textarea>
      <button type="submit">Send Message</button>
    </form>
  </section>

  <!-- Footer -->
  <footer>
    &copy; 2026 Moral Guide Awareness Initiative, Dutsinma.  
    Email: <a href="mailto:umarmgaid@gmail.com">umarmgaid@gmail.com</a>
  </footer>

</body>
</html>
